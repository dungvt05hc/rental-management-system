{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "// DefaultConnection": "Set via the DATABASE_URL environment variable. ./dev.sh does this for local development; see DEPLOYMENT.md for deployed environments.",
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Issuer": "RentalManagement.Api",
    "Audience": "RentalManagement.Client",
    "ExpirationHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rental-management-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
