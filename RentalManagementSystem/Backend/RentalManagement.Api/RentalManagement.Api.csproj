<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template email đi kèm assembly, nên deploy không phụ thuộc thư mục nội dung.
         Tên resource là RentalManagement.Api.Resources.EmailTemplates.{template}.{lang}.html

         WithCulture=false là bắt buộc: thấy phần ".vi."/".en." trong tên file,
         MSBuild mặc định hiểu đó là culture và đẩy file sang satellite assembly
         (vi/RentalManagement.Api.resources.dll), đồng thời cắt luôn phần ngôn ngữ
         khỏi tên resource — lúc đó cả hai bản chập vào một tên và không bản nào
         nằm trong assembly chính. -->
    <EmbeddedResource Include="Resources/EmailTemplates/*.html">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Font cho PDF. Không dựa vào font hệ thống: container deploy thường
         không có font nào ngoài vài font cơ bản, và font mặc định của QuestPDF
         thiếu glyph tiếng Việt — hoá đơn in ra thành "Phong tro" hoặc đầy ô
         vuông. Roboto phủ đủ Latin Extended Additional (U+1EA0–U+1EF9), tức
         toàn bộ nguyên âm có dấu của tiếng Việt.
         Roboto phát hành theo Apache License 2.0, xem Resources/Fonts/LICENSE.txt. -->
    <EmbeddedResource Include="Resources/Fonts/*.ttf">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Bảng dịch dùng chung với frontend. Một nguồn sự thật duy nhất:
         locales/*.json vừa được Vite nhúng vào bundle làm lớp dự phòng, vừa
         được nhúng vào assembly này để seed vào DB.

         LogicalName đặt tường minh vì file nằm ngoài cây thư mục dự án; nếu để
         MSBuild tự sinh, tên resource sẽ bám theo đường dẫn tương đối và đổi
         theo cấu trúc thư mục. WithCulture=false vì lý do đã nêu ở trên. -->
    <EmbeddedResource Include="../../Frontend/locales/en.json"
                      LogicalName="RentalManagement.Api.Resources.Locales.en.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="../../Frontend/locales/vi.json"
                      LogicalName="RentalManagement.Api.Resources.Locales.vi.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
